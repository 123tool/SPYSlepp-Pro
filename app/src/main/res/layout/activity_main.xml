<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#FFFFFF" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp" xmlns:android="[http://schemas.android.com/apk/res/android](http://schemas.android.com/apk/res/android)">

    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="SPYSlepp Pro" android:textColor="#000000" android:textSize="28sp" android:textStyle="bold"/>

    <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Privacy &amp; Security Tool" android:textColor="#555555"/>

    <View android:background="#000000" android:layout_height="2dp" android:layout_marginVertical="20dp" android:layout_width="match_parent"/>

    <EditText android:hint="Telegram Bot Token" android:id="@+id/etBotToken" android:inputType="textPassword" android:layout_height="wrap_content" android:layout_width="match_parent"/>

    <EditText android:hint="Telegram Chat ID" android:id="@+id/etChatId" android:inputType="number" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_width="match_parent"/>

    <Button android:backgroundTint="#000000" android:id="@+id/btnSave" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_width="match_parent" android:text="Simpan Konfigurasi" android:textColor="#FFFFFF"/>

    <Button android:backgroundTint="#FF5252" android:id="@+id/btnDelete" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_width="match_parent" android:text="Hapus Data" android:textColor="#FFFFFF"/>

    <TextView android:layout_gravity="center" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:layout_width="wrap_content" android:text="© Rolandino | [github.com/rolandino](https://github.com/rolandino)" android:textColor="#AAAAAA" android:textSize="12sp"/>

</LinearLayout>
